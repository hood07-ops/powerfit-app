{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "checkin",
          "value": "(?<alumno>[^&]+)"
        }
      ],
      "destination": "/checkin.html?alumno=:alumno",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://sabsmurhriohwmczaktn.supabase.co wss://sabsmurhriohwmczaktn.supabase.co https://api.mercadopago.com https://esm.sh; media-src 'self' blob: https://sabsmurhriohwmczaktn.supabase.co; frame-src https://www.mercadopago.cl https://www.mercadopago.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://www.mercadopago.cl https://www.mercadopago.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/cps.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/cps-admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/checkin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
