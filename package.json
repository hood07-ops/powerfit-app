{
  "name": "boxeo-rapa-nui-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite apps/powerfit360 --config apps/powerfit360/vite.config.js",
    "dev:powerfit": "npm run dev --workspace @powerfit/powerfit360",
    "dev:cps": "npm run dev --workspace @powerfit/cps",
    "build": "vite build apps/powerfit360 --config apps/powerfit360/vite.config.js",
    "build:powerfit": "npm run build --workspace @powerfit/powerfit360",
    "build:admin": "vite build apps/powerfit360 --config apps/powerfit360/vite.config.js --mode management",
    "build:coach": "vite build apps/powerfit360 --config apps/powerfit360/vite.config.js --mode professor_full",
    "build:alumno": "vite build apps/powerfit360 --config apps/powerfit360/vite.config.js --mode student",
    "build:management": "npm run build:admin",
    "build:student": "npm run build:alumno",
    "build:professor": "npm run build:coach",
    "build:cps": "npm run build --workspace @powerfit/cps",
    "lint": "eslint .",
    "preview": "vite preview apps/powerfit360 --config apps/powerfit360/vite.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-qr-code": "^2.0.21"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.12.0",
    "vite": "^8.0.12"
  }
}
